{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Fast day-to-day build",
      "description": "Ninja and no link-time optimisation, for building and running the tests while working. Releases and test builds keep the full optimisation.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LIVEDAW_LTO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "environment": {
        "CARGO_PROFILE_RELEASE_LTO": "off",
        "CARGO_PROFILE_RELEASE_CODEGEN_UNITS": "16",
        "CARGO_PROFILE_RELEASE_DEBUG": "0",
        "CARGO_PROFILE_RELEASE_INCREMENTAL": "true"
      }
    }
  ]
}
